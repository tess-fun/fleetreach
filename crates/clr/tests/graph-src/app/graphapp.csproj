<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds tests/graphapp.dll and graphlib.dll: dotnet build -c Release, then copy
       bin/Release/netstandard2.0/graphapp.dll and graphlib.dll. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../lib/graphlib.csproj" /></ItemGroup>
</Project>
